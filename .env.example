# Cloudflare Workers（wrangler CLI 用。VITE_ を付けないこと）
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# API
VITE_API_BASE_URL=http://localhost:8787/api
VITE_API_TIMEOUT=30000

# LINE Integration
# LINE のチャネルID・シークレット・アクセストークンはフロントエンドに置かない。
# API（Cloudflare Workers）だけが使い、本番は Workers Secrets、
# ローカルは apps/api/.dev.vars に設定する（apps/api/.dev.vars.example 参照）。
# 注意: VITE_ で始まる変数はビルド時にブラウザ向けJSへ埋め込まれ、誰でも読める。

# Environment
NODE_ENV=development
VITE_ENV=development
