import React from 'react';
import { DragDropContext, Droppable, Draggable, DropResult } from 'react-beautiful-dnd';
import { Appointment, Stylist, TimeSlot } from '../types';
import { useCurrentTime } from '../hooks/useCurrentTime';

interface Props {
  stylists: Stylist[];
  appointments: Appointment[];
  startHour?: number;
  endHour?: number;
  onAppointmentMove?: (appointmentId: string, newStylistId: string, newStartTime: string) => void;
}

export const ScheduleGrid: React.FC<Props> = ({ 
  stylists, 
  appointments,
  startHour = 9,
  endHour = 21,
  onAppointmentMove
}) => {
  const { now } = useCurrentTime();
  const timeSlots = Array.from({ length: endHour - startHour }, (_, i) => startHour + i);
  
  const getAppointmentsForStylist = (stylistId: string, hour: number) => {
    return appointments.filter(apt => {
      const startDate = new Date(apt.start_time);
      return apt.stylist_id === stylistId && startDate.getHours() === hour;
    });
  };

  // Calculate current time position within business hours
  const currentHour = now.getHours();
  const currentMinute = now.getMinutes();
  const isInBusinessHours = currentHour >= startHour && currentHour < endHour;
  const currentTimePercentage = isInBusinessHours 
    ? ((currentHour - startHour) * 60 + currentMinute) / ((endHour - startHour) * 60) * 100
    : -1;

  const handleDragEnd = (result: DropResult) => {
    const { source, destination, draggableId } = result;
    
    if (!destination) return;
    
    // Extract appointment ID from draggableId (format: "apt-{appointmentId}")
    const appointmentId = draggableId.replace('apt-', '');
    const appointment = appointments.find(a => a.id === appointmentId);
    
    if (!appointment) return;
    
    // Extract stylist ID and hour from destination
    const destinationStylistId = destination.droppableId.replace('hour-', '').split('-')[0];
    const newHour = parseInt(destination.droppableId.replace('hour-', '').split('-')[1]);
    
    // Calculate new start time
    const startDate = new Date(appointment.start_time);
    const newStartDate = new Date(startDate);
    newStartDate.setHours(newHour, 0, 0, 0);
    
    // Call callback to update appointment
    if (onAppointmentMove) {
      onAppointmentMove(appointmentId, destinationStylistId, newStartDate.toISOString());
    }
  };

  return (
    <DragDropContext onDragEnd={handleDragEnd}>
      <div style={{ overflowX: 'auto', flex: 1 }}>
        <div style={{ display: 'flex', minWidth: '100%' }}>
          {/* Time axis */}
          <div style={{ width: '80px', borderRight: '1px solid #e0e0e0' }}>
            <div style={{ height: '60px', borderBottom: '1px solid #e0e0e0' }}></div>
            {timeSlots.map(hour => (
              <div
                key={hour}
                style={{
                  height: '100px',
                  borderBottom: '1px solid #f0f0f0',
                  padding: '5px',
                  fontSize: '12px',
                  color: '#666'
                }}
              >
                {`${hour.toString().padStart(2, '0')}:00`}
              </div>
            ))}
          </div>

          {/* Stylists columns */}
          {stylists.map(stylist => (
            <div
              key={stylist.id}
              style={{
                flex: 1,
                minWidth: '200px',
                borderRight: '1px solid #e0e0e0',
                position: 'relative'
              }}
            >
              <div
                style={{
                  height: '60px',
                  padding: '10px',
                  borderBottom: '1px solid #e0e0e0',
                  fontSize: '14px',
                  fontWeight: 'bold',
                  color: '#333'
                }}
              >
                {stylist.name}
              </div>

              {/* Current time line - Red indicator */}
              {isInBusinessHours && (
                <div
                  style={{
                    position: 'absolute',
                    top: `${60 + (currentTimePercentage / 100) * (timeSlots.length * 100)}px`,
                    left: 0,
                    right: 0,
                    height: '2px',
                    background: '#ff0000',
                    zIndex: 10,
                    boxShadow: '0 0 3px rgba(255, 0, 0, 0.5)'
                  }}
                />
              )}

              {/* Hour slots */}
              {timeSlots.map(hour => (
                <Droppable key={`hour-${stylist.id}-${hour}`} droppableId={`hour-${stylist.id}-${hour}`}>
                  {(provided, snapshot) => (
                    <div
                      ref={provided.innerRef}
                      {...provided.droppableProps}
                      style={{
                        height: '100px',
                        borderBottom: '1px solid #f0f0f0',
                        padding: '5px',
                        position: 'relative',
                        backgroundColor: snapshot.isDraggingOver ? '#f0f8ff' : 'transparent',
                        ...provided.droppableProps.style
                      }}
                    >
                      {getAppointmentsForStylist(stylist.id, hour).map((apt, index) => (
                        <Draggable key={`apt-${apt.id}`} draggableId={`apt-${apt.id}`} index={index}>
                          {(provided, snapshot) => (
                            <div
                              ref={provided.innerRef}
                              {...provided.draggableProps}
                              {...provided.dragHandleProps}
                              style={{
                                background: apt.menu_color || '#1976d2',
                                color: '#fff',
                                padding: '5px',
                                borderRadius: '4px',
                                fontSize: '11px',
                                marginBottom: '3px',
                                cursor: 'grab',
                                opacity: snapshot.isDragging ? 0.5 : 1,
                                boxShadow: snapshot.isDragging ? '0 5px 15px rgba(0,0,0,0.3)' : 'none',
                                ...provided.draggableProps.style
                              }}
                            >
                              <div style={{ fontWeight: 'bold' }}>{apt.customer_name}</div>
                              <div>{apt.menu_name}</div>
                              <div>{new Date(apt.start_time).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' })}</div>
                            </div>
                          )}
                        </Draggable>
                      ))}
                      {provided.placeholder}
                    </div>
                  )}
                </Droppable>
              ))}
            </div>
          ))}
        </div>
      </div>
    </DragDropContext>
  );
};
